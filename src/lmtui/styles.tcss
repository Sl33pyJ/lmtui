/* ------ Global screen ------ */

Screen {
    background: #1e1e2e;
    color: #cdd6f4;
}

/* ------ Header / Footer ------ */

Header {
    background: #181825;
    color: #cba6f7;
}

Footer {
    background: #181825;
    color: #a6adc8;
}

/* ------ Main container ------ */

#main {
    padding: 1 2;
}

#now-playing-row {
    height: auto;
}

/* ------ Album art panel ------ */

#album-art {
    width: 44;
    height: auto;
    border: round #45475a;
    background: #181825;
    padding: 1;
    margin-right: 1;
}

#art-content {
    width: 40;
    height: auto;
}

/* ------ Now Playing panel ------ */

#now-playing {
    border: round #45475a;
    background: #181825;
    padding: 1 2;
    width: 1fr;
    height: auto;
}

#np-title {
    color: #cba6f7;
    text-style: bold;
    margin-bottom: 1;
}

#np-track {
    color: #a6e3a1;
    text-style: bold;
}

#np-artist {
    color: #cdd6f4;
}

#np-album {
    color: #6c7086;
    margin-bottom: 1;
}

#np-progress {
    width: 100%;
    margin-top: 1;
}

/* ------ AddToPlaylist modal ------ */

AddToPlaylistScreen {
    align: center middle;
}

#playlist-dialog {
    width: 50;
    height: auto;
    max-height: 80%;
    background: #181825;
    border: round #cba6f7;
    padding: 1 2;
}

#dialog-title {
    color: #cba6f7;
    text-style: bold;
    margin-bottom: 1;
}

#playlist-list {
    height: auto;
    max-height: 16;
    background: #1e1e2e;
    border: round #45475a;
}

PlaylistItem {
    padding: 0 1;
}

PlaylistItem.--highlight {
    background: #45475a;
}

#dialog-hint {
    color: #6c7086;
    margin-top: 1;
    text-align: center;
}

/* ------ LibraryBrowser modal ------ */

LibraryBrowserScreen {
    background: #1e1e2e;
}

#library-layout {
    height: 100%;
    padding: 1 2;
}

#library-sidebar {
    width: 30;
    border: round #45475a;
    background: #181825;
    padding: 0 1;
    margin-right: 1;
}

#library-sidebar-title {
    color: #cba6f7;
    text-style: bold;
    padding: 1 0;
}

#library-playlists {
    height: 1fr;
    background: #181825;
}

#library-main {
    width: 1fr;
    border: round #45475a;
    background: #181825;
    padding: 0 1;
}

#library-tracks-title {
    color: #cba6f7;
    text-style: bold;
    padding: 1 0;
}

#library-tracks {
    height: 1fr;
    background: #181825;
}

DataTable > .datatable--header {
    background: #181825;
    color: #cba6f7;
}

DataTable > .datatable--cursor {
    background: #45475a;
    color: #cdd6f4;
}

/* ------ Library search input ------ */

#library-search {
    background: #1e1e2e;
    border: round #45475a;
    color: #cdd6f4;
    margin-bottom: 1;
    height: 3;
}

#library-search:focus {
    border: round #cba6f7;
}

/* Hide horizontal scrollbar on the tracks table — column widths are
   handled internally and the scrollbar is visual noise. */

#library-tracks {
    scrollbar-size-horizontal: 0;
}
/* ------ Queue modal ------ */

QueueScreen {
    background: #1e1e2e;
}

#queue-layout {
    height: 100%;
    padding: 1 2;
}

#queue-title {
    color: #cba6f7;
    text-style: bold;
    padding: 1 0 0 0;
}

#queue-subtitle {
    color: #6c7086;
    padding: 0 0 1 0;
}

#queue-tracks {
    height: 1fr;
    background: #181825;
    border: round #45475a;
    scrollbar-size-horizontal: 0;
}

QueueScreen DataTable > .datatable--header {
    background: #181825;
    color: #cba6f7;
}

QueueScreen DataTable > .datatable--cursor {
    background: #45475a;
    color: #cdd6f4;
}
