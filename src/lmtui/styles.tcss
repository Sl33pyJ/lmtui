/* ------ Catppuccin Mocha reference ------
   base #1e1e2e  mantle #181825  crust #11111b
   surface0 #313244  surface1 #45475a  surface2 #585b70
   overlay0 #6c7086  text #cdd6f4
   mauve #cba6f7  green #a6e3a1  blue #89b4fa  lavender #b4befe
   ------------------------------------------------- */

/* ------ Screen / Header / Footer ------ */

Screen {
    background: #1e1e2e;
    color: #cdd6f4;
}

Header {
    background: #181825;
    color: #cba6f7;
}

Footer {
    background: #181825;
    color: #a6adc8;
}

/* ------ Main container ------ */

#main {
    padding: 0 1;
    height: 1fr;
}

#body-row {
    height: 1fr;
}

/* ------ Left: queue panel (border only here) ------ */

#queue-panel {
    width: 42%;
    min-width: 26;
    height: 100%;
    background: #181825;
    border: round #45475a;
    padding: 0 1;
    margin-right: 1;
}

#queue-title {
    color: #cba6f7;
    text-style: bold;
    height: 2;
    padding: 1 0 0 0;
}

#queue-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#queue-content {
    color: #cdd6f4;
    padding: 0 0 1 0;
}

/* ------ Right column (no borders) ------ */

#right-column {
    width: 1fr;
    height: 100%;
}

/* Visualizer (top) */

#visualizer-panel {
    width: 100%;
    height: 3fr;
    background: #181825;
    padding: 0 1;
    margin-bottom: 1;
    overflow: hidden;
}

#viz-title {
    color: #cba6f7;
    text-style: bold;
    height: 2;
    padding: 1 0 0 0;
}

#viz-content {
    width: 100%;
    height: 1fr;
    color: #6c7086;
}

/* Lyrics (bottom) */

#lyrics-panel {
    width: 100%;
    height: 2fr;
    background: #181825;
    padding: 0 1;
}

#lyr-title {
    color: #cba6f7;
    text-style: bold;
    height: 2;
    padding: 1 0 0 0;
}

#lyr-content {
    color: #6c7086;
    padding: 0 0 1 0;
}

/* ------ Now playing bar ------ */

#now-playing-bar {
    width: 100%;
    height: 6;
    background: #181825;
    padding: 0 2;
    margin-top: 1;
}

#np-bar-inner {
    width: 100%;
    height: 100%;
}

#np-art {
    width: 8;
    height: 4;
    background: transparent;
    padding: 0;
    margin-right: 2;
    content-align: left top;
    margin-top: 1;
}

#np-art-content {
    width: auto;
    height: auto;
}

#np-bar-text {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

#np-line1 {
    width: 100%;
    height: 1;
    content-align: left middle;
    margin-top: 1;
}

#np-line2 {
    width: 100%;
    height: 1;
    content-align: left middle;
    margin-top: 1;
}

/* ------ AddToPlaylist modal ------ */

AddToPlaylistScreen {
    align: center middle;
    background: #11111b 70%;
}

#playlist-dialog {
    width: 50;
    height: auto;
    max-height: 80%;
    background: #181825;
    border: round #cba6f7;
    padding: 1 2;
}

#dialog-title {
    color: #cba6f7;
    text-style: bold;
    margin-bottom: 1;
}

#playlist-list {
    height: auto;
    max-height: 16;
    background: #1e1e2e;
    padding: 0 1;
}

PlaylistItem {
    padding: 0 1;
}

PlaylistItem.--highlight {
    background: #45475a;
}

#dialog-hint {
    color: #6c7086;
    margin-top: 1;
    text-align: center;
}

/* ------ LibraryBrowser modal ------ */

LibraryBrowserScreen {
    background: #1e1e2e;
}

#library-layout {
    height: 100%;
    padding: 1 2;
}

#library-sidebar {
    width: 22%;
    min-width: 20;
    max-width: 34;
    background: #181825;
    padding: 1 2;
    margin-right: 1;
}

#library-sidebar-title {
    color: #89b4fa;
    text-style: bold;
    padding: 0 0 1 0;
}

#library-playlists {
    height: 1fr;
    background: #181825;
}

#library-main {
    width: 1fr;
    background: #181825;
    padding: 1 2;
}

#library-tracks-title {
    color: #cba6f7;
    text-style: bold;
    padding: 0 0 1 0;
}

#library-tracks {
    height: 1fr;
    background: #181825;
    scrollbar-size-horizontal: 0;
}

DataTable > .datatable--header {
    background: #181825;
    color: #cba6f7;
}

DataTable > .datatable--cursor {
    background: #45475a;
    color: #cdd6f4;
}

#library-search {
    background: #1e1e2e;
    color: #cdd6f4;
    margin-bottom: 1;
    height: 3;
    border: none;
    padding: 0 1;
}

/* ------ Queue modal (still available via `u`) ------ */

QueueScreen {
    background: #1e1e2e;
}

#queue-layout {
    height: 100%;
    padding: 1 2;
}

#queue-title {
    color: #cba6f7;
    text-style: bold;
    padding: 1 0 0 0;
}

#queue-subtitle {
    color: #6c7086;
    padding: 0 0 1 0;
}

#queue-tracks {
    height: 1fr;
    background: #181825;
    scrollbar-size-horizontal: 0;
}

QueueScreen DataTable > .datatable--header {
    background: #181825;
    color: #cba6f7;
}

QueueScreen DataTable > .datatable--cursor {
    background: #45475a;
    color: #cdd6f4;
}
